{
  "name": "ai-harness-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Codex CLI analytics dashboard.",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc -p tsconfig.web.json",
    "dev": "npm run build && node dist/src/server/index.js",
    "start": "NODE_ENV=production node dist/src/server/index.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
